<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="CSX" Company="CSX">
  <Profiles>
    <SystemCollector Id="AssetCollector" Name="CSX asset CPU wait and IO">
      <BufferSize Value="1024" />
      <Buffers Value="128" />
    </SystemCollector>
    <SystemProvider Id="AssetProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
        <Keyword Value="Filename" />
        <Keyword Value="DiskIO" />
        <Keyword Value="DiskIOInit" />
        <Keyword Value="HardFaults" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
      </Stacks>
    </SystemProvider>
    <Profile Id="CSXAssetLoads.Verbose.File" Name="CSXAssetLoads"
             Description="Opt-in asset CPU stacks, waits, file and disk IO; correlate QPC and thread IDs with the DevBench stutter journal"
             LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="AssetCollector">
          <SystemProviderId Value="AssetProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
