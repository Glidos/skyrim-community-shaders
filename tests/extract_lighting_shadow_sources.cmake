include("${PROJECT_ROOT}/tests/extract_source_region.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(READ "${PROJECT_ROOT}/package/Shaders/Lighting.hlsl" _lighting)
extract_between("${_lighting}" "\tconst bool hasEngineDirectionalShadowMask =" "\n\n\tbool inDirShadow" mask.hlsli)
extract_between("${_lighting}" "\tfloat dirSoftShadow = 1.0;" "#\tif defined(SCREEN_SPACE_SHADOWS) && defined(DEFERRED)" selection.hlsli)
extract_between("${_lighting}" "#\tif defined(SKYLIGHTING_SHADOW_VIS)\n\tif (useSkylightingShadow)" "\n\tfloat3 diffuseColor =" merge.hlsli)
file(READ "${PROJECT_ROOT}/package/Shaders/Common/Permutation.hlsli" PERMUTATION)
file(READ "${PROJECT_ROOT}/package/Shaders/Common/LightingFlags.hlsli" LIGHTING_FLAGS)
string(REPLACE [[#include "Common/Permutation.hlsli"]] "" LIGHTING_FLAGS "${LIGHTING_FLAGS}")
file(READ "${OUTPUT_DIRECTORY}/mask.hlsli" ENGINE_MASK)
file(READ "${OUTPUT_DIRECTORY}/selection.hlsli" SHADOW_SELECTION)
file(READ "${OUTPUT_DIRECTORY}/merge.hlsli" SKYLIGHTING_MERGE)
configure_file("${PROJECT_ROOT}/tests/lighting_shadow_sources.hlsl.in" "${OUTPUT_DIRECTORY}/lighting_shadow_sources.hlsl" @ONLY)
