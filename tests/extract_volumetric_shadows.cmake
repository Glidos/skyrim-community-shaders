include("${PROJECT_ROOT}/tests/extract_source_region.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
file(READ "${PROJECT_ROOT}/src/Features/VolumetricShadows.cpp" _source)
file(READ "${PROJECT_ROOT}/src/Features/VolumetricShadows.h" _header)
extract_between("${_source}" "\ttemplate <class T>\n\tvoid SafeRelease" "\nvoid VolumetricShadows::SetupResources()" helpers.h)
file(READ "${OUTPUT_DIRECTORY}/helpers.h" _helpers)
extract_between("${_source}" "\tbool HasActiveDirectionalShadows()" "\tvoid DrawEnabledCheckbox" active.h)
file(READ "${OUTPUT_DIRECTORY}/active.h" _active)
file(READ "${PROJECT_ROOT}/src/Utils/D3D.cpp" _d3d)
extract_between("${_d3d}" "\tbool GetTexture2DDesc(" "\tbool TryGetDepthSrvDimensions(" texture_desc.h)
file(READ "${OUTPUT_DIRECTORY}/texture_desc.h" _texture_desc)
file(WRITE "${OUTPUT_DIRECTORY}/volumetric_shadows_helpers.h" "namespace Util {\n${_texture_desc}}\nnamespace {\n${_active}${_helpers}")
extract_between("${_header}" "\tUtil::LazyShader<ID3D11ComputeShader> downsampleShadowMip0CS;" "\nprivate:" volumetric_shadows_resources.h)
extract_between("${_source}" "void VolumetricShadows::SetupResources()" "void VolumetricShadows::EnsureFallbackShadowTexture()" setup.h)
extract_between("${_source}" "void VolumetricShadows::EnsureFallbackShadowTexture()" "void VolumetricShadows::DrawSettings()" prepare.h)
extract_between("${_source}" "void VolumetricShadows::ClearShaderCache()" "struct CreateDepthStencil_VolumetricLighting" release.h)
file(WRITE "${OUTPUT_DIRECTORY}/volumetric_shadows_under_test.h" "")
foreach(_part setup prepare release)
    file(READ "${OUTPUT_DIRECTORY}/${_part}.h" _text)
    file(APPEND "${OUTPUT_DIRECTORY}/volumetric_shadows_under_test.h" "${_text}\n")
endforeach()
