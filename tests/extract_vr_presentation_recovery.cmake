if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/Features/Upscaling.cpp" _source)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
include("${CMAKE_CURRENT_LIST_DIR}/extract_source_region.cmake")
extract_between("${_source}" "bool Upscaling::EnsureVRRenderScaleProviderNeutralNativeRecovery(" "bool Upscaling::HasLiveVRRenderScaleProviderNeutralRecoveryWorker() const" "vr_presentation_native_recovery_under_test.h")
extract_between("${_source}" "bool Upscaling::ShouldDeferVRRenderScalePresentationSuccessor() const" "void Upscaling::LogVRRenderScalePresentationStall(" "vr_presentation_owner_under_test.h")
foreach(_name IN ITEMS kVRRenderScalePostMutationStalledDeadlineMilliseconds kVRRenderScalePostMutationEmergencyAttemptDelayMilliseconds kVRRenderScalePresentationRetryMilliseconds)
    string(REGEX MATCH "constexpr uint64_t ${_name} = [0-9]+u;" _constant "${_source}")
    if(NOT _constant)
        message(FATAL_ERROR "Presentation recovery cannot find ${_name}")
    endif()
    file(APPEND "${OUTPUT_DIRECTORY}/vr_presentation_owner_under_test.h" "${_constant}\n")
endforeach()
extract_between("${_source}" "bool Upscaling::TryResumeVRRenderScalePresentation(" "void Upscaling::ServiceDeferredVRRenderScaleRequestAfterPhysicalRecovery()" "vr_presentation_recovery_under_test.h")
