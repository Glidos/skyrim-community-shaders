if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/Features/Upscaling.cpp" _source)
file(READ "${PROJECT_ROOT}/src/Features/Upscaling.h" _header)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
include("${CMAKE_CURRENT_LIST_DIR}/extract_source_region.cmake")
set(_mutexes "")
foreach(_name IN ITEMS g_vrLoadingMenuGateReconciliationMutex g_vrLoadingTransitionSerialMutex)
    string(REGEX MATCH "std::(recursive_mutex|mutex) ${_name};" _declaration "${_source}")
    if(NOT _declaration)
        message(FATAL_ERROR "Presentation recovery cannot find mutex ${_name}")
    endif()
    string(APPEND _mutexes "${_declaration}\n")
endforeach()
string(APPEND _mutexes "struct PresentationRecoveryMutexes {\n")
foreach(_name IN ITEMS perfModeRenderTargetRecreateQueueMutex vrRenderScalePhysicalMutationMutex vrPostLoadCompositorHoldMutex pendingVRRenderScaleRequestMutex)
    string(REGEX MATCH "mutable std::(recursive_mutex|mutex) ${_name};" _declaration "${_header}")
    if(NOT _declaration)
        message(FATAL_ERROR "Presentation recovery cannot find mutex ${_name}")
    endif()
    string(APPEND _mutexes "${_declaration}\n")
endforeach()
string(APPEND _mutexes "};\n")
file(WRITE "${OUTPUT_DIRECTORY}/vr_presentation_mutexes_under_test.h" "${_mutexes}")
extract_between("${_source}" "void Upscaling::ResetVRPostLoadCompositorHold()" "void Upscaling::ResetVRPostLoadCompositorHoldLocked(" "vr_presentation_hold_reset_under_test.h")
extract_between("${_source}" "bool Upscaling::EnsureVRRenderScaleProviderNeutralNativeRecovery(" "bool Upscaling::HasLiveVRRenderScaleProviderNeutralRecoveryWorker() const" "vr_presentation_native_recovery_under_test.h")
extract_between("${_source}" "bool Upscaling::ShouldDeferVRRenderScalePresentationSuccessor() const" "void Upscaling::LogVRRenderScalePresentationStall(" "vr_presentation_owner_under_test.h")
foreach(_name IN ITEMS kVRRenderScalePostMutationStalledDeadlineMilliseconds kVRRenderScalePostMutationEmergencyAttemptDelayMilliseconds kVRRenderScalePresentationRetryMilliseconds)
    string(REGEX MATCH "constexpr uint64_t ${_name} = [0-9]+u;" _constant "${_source}")
    if(NOT _constant)
        message(FATAL_ERROR "Presentation recovery cannot find ${_name}")
    endif()
    file(APPEND "${OUTPUT_DIRECTORY}/vr_presentation_owner_under_test.h" "${_constant}\n")
endforeach()
extract_between("${_source}" "bool Upscaling::TryResumeVRRenderScalePresentationLocked(" "void Upscaling::ServiceDeferredVRRenderScaleRequestAfterPhysicalRecovery()" "vr_presentation_recovery_under_test.h")
