if(NOT DEFINED PROJECT_ROOT OR NOT DEFINED OUTPUT_DIRECTORY)
    message(FATAL_ERROR "PROJECT_ROOT and OUTPUT_DIRECTORY are required")
endif()
file(READ "${PROJECT_ROOT}/src/Features/Upscaling.cpp" _source)
file(READ "${PROJECT_ROOT}/src/Features/Upscaling.h" _header)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
include("${CMAKE_CURRENT_LIST_DIR}/extract_source_region.cmake")
extract_between("${_header}" "\tstruct Settings\n" "\n\tSettings settings;" "upscaling_settings_members.h")
extract_between("${_header}" "\tenum class UpscaleMethod\n" "\tenum class NeuralStereoRouteRole" "upscaling_settings_enums.h")
extract_between("${_header}" "\tenum class DLSSSharpenerMode" "\t// Shared DLSS/FSR" "upscaling_settings_sharpener.h")
foreach(_name IN ITEMS kDLSSPresetK kFsr4RuntimeSelectionSchemaVersion kFoveatedBlendFeatherMin kFoveatedBlendFeatherMax)
    string(REGEX MATCH "static constexpr [^\n]+ ${_name} = [^;]+;" _constant "${_header}")
    if(NOT _constant)
        message(FATAL_ERROR "Upscaling settings cannot find ${_name}")
    endif()
    file(APPEND "${OUTPUT_DIRECTORY}/upscaling_settings_enums.h" "${_constant}\n")
endforeach()
extract_between("${_source}" "namespace FSRTemporalTuningPolicy\n" "decltype(&D3D11CreateDeviceAndSwapChain)" "upscaling_settings_serialization_under_test.h")
